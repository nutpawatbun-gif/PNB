<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Route /api/* calls to api.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^api/(.*)$ api.php?action=$1 [QSA,L]

  # 2. React SPA Fallback: Redirect all other non-file requests to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Security: Protect sensitive config files
<Files "config.php">
  Order Allow,Deny
  Deny from all
</Files>
